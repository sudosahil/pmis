# Absolute origin of the PMIS API, e.g. https://pmis-api.onrender.com
#
# Leave this unset when the site and the API share an origin — the dev server
# proxies /api to localhost:4000, and a single-host deployment serves both from
# one domain. Set it when the two are hosted separately, as they are when the
# site is on Vercel and the API is on a host with a persistent disk.
#
# It is read at BUILD time, not at run time: changing it needs a redeploy.
# VITE_API_BASE_URL=https://pmis-api.onrender.com
