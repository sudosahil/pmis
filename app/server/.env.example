# Copy to .env and adjust. The dev defaults below let the stack boot with no edits.
NODE_ENV=development
PORT=4000

# SQLite file. Relative paths resolve against app/server/.
DATABASE_FILE=./data/pmis.db

# Where uploaded files are written. On a host this must point at the mounted
# disk, or every upload is lost on the next deploy.
DATA_DIR=./data

# Replace both secrets before any non-local deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# bcrypt work factor. Never drop below 12 outside tests.
BCRYPT_ROUNDS=12

# What to install when the database is found empty at boot:
#   off       — nothing (the default; you seed it yourself)
#   essential — roles, approval chains and master lists, plus one administrator
#               taken from ADMIN_* below. Use this for an instance holding real work.
#   demo      — the full demonstration department. Published password; never for real work.
SEED_ON_BOOT=off
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pmis.local
# ADMIN_PASSWORD=      # required when SEED_ON_BOOT=essential
